rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Chat images folder
    match /chat_images/{visitorId}/{fileName} {
      allow read: if true;
      allow write: if request.resource.size <= 5 * 1024 * 1024
                   && (request.resource.contentType.matches('image/jpeg')
                       || request.resource.contentType.matches('image/png')
                       || request.resource.contentType.matches('image/webp'));
      allow delete: if request.auth != null
                    && (request.auth.token.email == 'elonmuskspace241@gmail.com' || request.auth.token.email == 'biologyboyboy@gmail.com')
                    && request.auth.token.email_verified == true;
    }

    // Voice notes folder (Audio uploads)
    match /voice_notes/{uid}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.size <= 10 * 1024 * 1024
                   && request.resource.contentType.matches('audio/.*');
      allow delete: if request.auth != null
                    && (request.auth.uid == uid || request.auth.token.email == 'elonmuskspace241@gmail.com');
    }

    // Lounge and private chat attachments
    match /attachments/{folder}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null && request.resource.size <= 10 * 1024 * 1024;
      allow delete: if request.auth != null;
    }
  }
}
