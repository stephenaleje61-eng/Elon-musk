rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isVerifiedAdmin() {
      return request.auth != null &&
        (request.auth.token.email == 'elonmuskspace241@gmail.com' || request.auth.token.email == 'biologyboyboy@gmail.com') &&
        request.auth.token.email_verified == true;
    }

    // Connection test document
    match /test/connection {
      allow read, write: if true;
    }

    // 1. Users collection (instant guest profiles)
    match /users/{uid} {
      allow read, write: if true;
      allow delete: if isVerifiedAdmin();
    }

    // 2. Unique username claims
    match /usernames/{usernameLower} {
      allow read, write: if true;
    }

    // 3. Public Channels (e.g., Elon Musk Lounge)
    match /channels/{channelId}/messages/{messageId} {
      allow read, write: if true;
      allow delete: if isVerifiedAdmin();
    }

    // 4. Private Conversations
    match /private_conversations/{conversationId} {
      allow read, write: if true;
      allow delete: if isVerifiedAdmin();

      match /messages/{messageId} {
        allow read, write: if true;
        allow delete: if isVerifiedAdmin();
      }
    }

    // 5. Reports for abuse
    match /reports/{reportId} {
      allow read, write: if true;
    }

    // 6. Direct line with Elon Musk (persistent visitor chat)
    match /conversations/{visitorId} {
      allow read, write: if true;
      allow delete: if isVerifiedAdmin();

      match /messages/{messageId} {
        allow read, write: if true;
        allow delete: if isVerifiedAdmin();
      }
    }

    // Requests collection
    match /requests/{requestId} {
      allow read, write: if true;
      allow delete: if isVerifiedAdmin();
    }

    // Admin audit logs
    match /admin_audit_logs/{logId} {
      allow read, write: if true;
      allow delete: if false;
    }

    // Default catch-all
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
